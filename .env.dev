# DEV environment variables.
#
# The deploy workflow copies this file to .env.local before `pnpm build`
# (`cp .env.dev .env.local`). All vars are NEXT_PUBLIC_* and are inlined into
# the browser bundle at BUILD time — a static export has no runtime server.
#
# Values below are dummy placeholders; replace with real DEV values.

# Origin of the Hive backend the browser calls directly (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=https://hive-dev.example.com

# Optional version prefix prepended to the axios baseURL. The tenant endpoints
# already include /api/v1 in their path, so leave this empty unless the backend
# expects an extra prefix.
NEXT_PUBLIC_API_VERSION=

# LaunchDarkly client-side ID. In CI this is injected from the
# PULSE_LD_CLIENT_ID_DEV secret (see deploy-dev.yml); set a value here only for
# local builds.
NEXT_PUBLIC_LD_CLIENT_ID=dummy-ld-client-id
